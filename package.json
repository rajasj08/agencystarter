{
  "name": "agencystarter",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n backend,frontend,docsite -c blue,magenta,green \"npm run dev:backend\" \"npm run dev:frontend\" \"npm run dev:docsite\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev:docsite": "npm run dev --prefix docsite",
    "security:test": "npm run test --prefix backend -- src/__tests__/security-invariants.invariant.test.ts src/__tests__/security-chaos.invariant.test.ts src/__tests__/sso-security.invariant.test.ts"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  }
}
